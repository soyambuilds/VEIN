PORT=5000
NODE_ENV=development
# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/vein
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Frontend origin allowed by CORS (not needed when the server serves the built client)
CLIENT_URL=http://localhost:5173
# The first admin account is created automatically at startup
ADMIN_NAME=VEIN Admin
ADMIN_EMAIL=admin@vein.local
ADMIN_PASSWORD=Admin@12345
# Where uploaded documents are stored (mount a persistent disk in production)
UPLOAD_DIR=./uploads
